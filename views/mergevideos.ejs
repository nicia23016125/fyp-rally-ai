<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Merger - Library</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; color: #333; }
        .main-content { padding: 20px; }
        h1, h2 { color: #2c3e50; }
        
        /* Grids */
        .video-grid { 
            display: flex; flex-wrap: wrap; gap: 20px; padding: 20px; 
            background: #fff; border: 2px dashed #cbd5e0; border-radius: 12px; min-height: 150px;
        }

        .video-card { 
            background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; 
            padding: 10px; width: 220px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transition: transform 0.2s; position: relative;
        }
        .source-clip { cursor: grab; }
        .source-clip:active { cursor: grabbing; }
        
        .video-card video { 
            border-radius: 4px; background: #000; display: block; 
            margin-bottom: 10px; width: 100%; object-fit: cover; height: 120px;
        }
        
        .video-info { 
            font-size: 0.85rem; margin-bottom: 5px; white-space: nowrap; 
            overflow: hidden; text-overflow: ellipsis; color: #4a5568;
        }

        .controls { 
            display: flex; align-items: center; justify-content: space-between; 
            border-top: 1px solid #eee; padding-top: 8px; 
        }

        /* Buttons */
        .action-area { display: flex; align-items: center; gap: 15px; margin-top: 20px; flex-wrap: wrap; }
        .merge-btn { background-color: #4a90e2; color: white; padding: 12px 30px; border: none; border-radius: 6px; font-weight: bold; transition: 0.3s; }
        .merge-btn:hover { background-color: #357abd; }
        
        .tiktok-btn {
            background-color: #010101; color: white !important; padding: 12px 25px; border-radius: 6px; 
            font-weight: bold; text-decoration: none; transition: 0.3s; display: inline-flex; align-items: center; border: 2px solid #010101;
        }
        .tiktok-btn:hover { background-color: #fe2c55; border-color: #25f4ee; transform: translateY(-2px); box-shadow: 3px 3px 0px #25f4ee; }

        /* Style for My Images button (Green) */
        .img-gallery-btn {
            border: 2px solid #198754; color: #198754; padding: 8px 20px; border-radius: 6px; font-weight: bold; text-decoration: none; transition: 0.3s;
        }
        .img-gallery-btn:hover { background-color: #198754; color: white !important; transform: translateY(-2px); }

        /* Style for My Videos button (Blue) */
        .vid-gallery-btn {
            border: 2px solid #0d6efd; color: #0d6efd; padding: 8px 20px; border-radius: 6px; font-weight: bold; text-decoration: none; transition: 0.3s;
        }
        .vid-gallery-btn:hover { background-color: #0d6efd; color: white !important; transform: translateY(-2px); }

        .sortable-ghost { opacity: 0.4; background: #ebf8ff; border: 2px solid #4299e1; }
        .status-msg { margin: 20px 0; padding: 15px; border-radius: 6px; background: #c6f6d5; color: #22543d; }
    </style>
</head>
<body>

    <%- include('partials/navbar.ejs') %>

    <div class="container main-content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1>Source Clips</h1>
                <p class="text-muted mb-0">Drag clips to set the sequence. Check "Include" to add them to your merge.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/viewvideos" class="vid-gallery-btn">
                    <i class="fas fa-film me-2"></i>My Videos
                </a>
                <a href="/myimages" class="img-gallery-btn">
                    <i class="fas fa-images me-2"></i>My Images
                </a>
                <span class="badge bg-secondary d-flex align-items-center">Step 1: Select & Order</span>
            </div>
        </div>

        <% if (locals.message) { %>
            <div class="status-msg"><i class="fas fa-check-circle me-2"></i><%= message %></div>
        <% } %>

        <form id="mergeForm" action="/merge-videos" method="POST">
            <div id="video-list" class="video-grid">
                <% if (videos && videos.length > 0) { %>
                    <% videos.forEach((video) => { %>
                        <div class="video-card source-clip">
                            <video muted onmouseover="this.play()" onmouseout="this.pause(); this.currentTime=0;">
                                <source src="<%= video.cleanUrl %>" type="video/mp4">
                            </video>
                            
                            <div class="video-info"><strong><%= video.displayName %></strong></div>
                            <input type="hidden" class="video-path-input" value="<%= video.cleanUrl %>">
                            
                            <div class="controls">
                                <label style="font-size: 0.8rem; cursor: pointer;">
                                    <input type="checkbox" class="merge-checkbox"> Include
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" 
                                        onclick="openTrimModal('<%= encodeURIComponent(video.cleanUrl) %>')">
                                    <i class="fas fa-cut"></i>
                                </button>
                                <span style="color: #a0aec0; font-size: 0.7rem;">⠿ Drag</span>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="w-100 text-center py-5">
                        <p class="text-muted">No clips found in your library.</p>
                        <a href="/myimages" class="btn btn-success">Check Image Gallery</a>
                    </div>
                <% } %>
            </div>

            <div class="action-area">
                <button type="submit" id="submitBtn" class="merge-btn">
                    <i class="fas fa-layer-group me-2"></i>Merge Selected
                </button>
                <a href="/tiktok" class="tiktok-btn">
                    <i class="fab fa-tiktok me-2"></i>Post to TikTok
                </a>
            </div>
        </form>

        <hr class="my-5">

        <div class="mb-3">
            <h2>Your Merged Projects</h2>
            <p class="text-muted">Final videos created from your merged clips.</p>
        </div>

        <div class="video-grid" style="border-style: solid; border-color: #e2e8f0; background: #f8fafc;">
            <% if (mergedVideos && mergedVideos.length > 0) { %>
                <% mergedVideos.forEach((merged) => { %>
                    <div class="video-card">
                        <video controls>
                            <source src="<%= merged.cleanUrl %>" type="video/mp4">
                        </video>
                        <div class="video-info"><strong><%= merged.displayName %></strong></div>
                        <div class="d-flex justify-content-between mt-2">
                            <a href="<%= merged.cleanUrl %>" download class="btn btn-sm btn-link p-0 text-decoration-none">
                                <i class="fas fa-download"></i> Save
                            </a>
                            <small class="text-muted"><%= new Date(merged.created_at).toLocaleDateString() %></small>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="w-100 text-center py-4 text-muted">You haven't merged any videos yet.</p>
            <% } %>
        </div>
    </div>

    <div class="modal fade" id="trimModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5>Trim Clip</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <video id="trimPreview" controls width="100%" class="rounded bg-black"></video>
                    <div class="row mt-3">
                        <div class="col"><label>Start (s)</label><input type="number" id="trimStart" class="form-control" value="0" step="0.1"></div>
                        <div class="col"><label>End (s)</label><input type="number" id="trimEnd" class="form-control" step="0.1"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary w-100" onclick="submitTrim()">Save Trimmed Version</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sortable
        Sortable.create(document.getElementById('video-list'), { animation: 150, ghostClass: 'sortable-ghost', handle: '.source-clip' });

        // Merge Logic
        document.getElementById('mergeForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const cards = document.querySelectorAll('.source-clip');
            let count = 0;
            cards.forEach(card => {
                const cb = card.querySelector('.merge-checkbox');
                if (cb.checked) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'orderedPaths';
                    input.value = card.querySelector('.video-path-input').value;
                    this.appendChild(input);
                    count++;
                }
            });
            if (count < 2) return alert("Select 2+ clips");
            document.getElementById('submitBtn').disabled = true;
            this.submit();
        });

        // Trim Logic
        let currentTrimUrl = "";
        const trimModal = new bootstrap.Modal(document.getElementById('trimModal'));
        function openTrimModal(url) {
            currentTrimUrl = decodeURIComponent(url);
            const v = document.getElementById('trimPreview');
            v.src = currentTrimUrl;
            v.onloadedmetadata = () => document.getElementById('trimEnd').value = v.duration.toFixed(1);
            trimModal.show();
        }

        async function submitTrim() {
            const res = await fetch('/trim-video', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    videoUrl: currentTrimUrl,
                    startTime: document.getElementById('trimStart').value,
                    endTime: document.getElementById('trimEnd').value
                })
            });
            if ((await res.json()).success) location.reload();
        }
    </script>
</body>
</html>