<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  
  <style>
    body { background-color: #f4f7f6; font-family: 'Segoe UI', sans-serif; }
    .main-container { max-width: 1200px; margin: 40px auto; }
    
    /* Grid Layout */
    .video-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); 
        gap: 25px; 
    }

    /* Card Styles */
    .project-card { 
        background: #fff; border: none; border-radius: 12px; overflow: hidden; 
        box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.2s; 
    }
    .project-card:hover { transform: translateY(-5px); }
    
    .video-wrapper { position: relative; background: #000; height: 180px; }
    .video-wrapper video { width: 100%; height: 100%; object-fit: contain; }
    
    .card-body { padding: 15px; }
    
    .project-title { 
        font-weight: 700; font-size: 1rem; margin-bottom: 5px; 
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; 
    }

    /* Badges */
    .badge-merged { background-color: #ebf8ff; color: #3182ce; border: 1px solid #bee3f8; }
    .badge-trimmed { background-color: #f0fff4; color: #38a169; border: 1px solid #c6f6d5; }
    
    .user-info { display: flex; align-items: center; margin-top: 15px; padding-top: 10px; border-top: 1px solid #eee; }
    .user-avatar { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; margin-right: 10px; }
    .user-name { font-size: 0.85rem; font-weight: 600; color: #555; }
  </style>
</head>
<body>

  <%- include ('partials/navbar.ejs') %>

  <div class="container main-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="javascript:history.back()" class="text-decoration-none text-secondary small mb-2 d-block">
                <i class="fas fa-arrow-left me-1"></i> Back
            </a>
            <h2><%= pageTitle %></h2>
        </div>
        <span class="badge bg-primary"><%= videos.length %> Videos</span>
    </div>

    <% if (videos && videos.length > 0) { %>
        <div class="video-grid">
            <% videos.forEach(video => { %>
                <div class="project-card">
                    <div class="video-wrapper">
                        <video controls preload="metadata">
                            <source src="<%= video.file_path %>" type="video/mp4">
                        </video>
                    </div>
                    
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <% if (video.type === 'merged') { %>
                                <span class="badge badge-merged rounded-pill">Merged Sequence</span>
                            <% } else { %>
                                <span class="badge badge-trimmed rounded-pill">Trimmed Clip</span>
                            <% } %>
                            <small class="text-muted"><%= new Date(video.created_at).toLocaleDateString() %></small>
                        </div>

                        <a href="/content-items/<%= video.id %>" class="text-decoration-none text-dark">
                            <div class="project-title" title="<%= video.title %>">
                                <%= video.title || "Untitled Project" %>
                                <i class="fas fa-external-link-alt ms-2 text-muted" style="font-size: 0.8em;"></i>
                            </div>
                        </a>

                        <div class="user-info">
                            <% if (video.userImage) { %>
                                <img src="/images/<%= video.userImage %>" class="user-avatar" alt="User">
                            <% } else { %>
                                <img src="https://via.placeholder.com/30" class="user-avatar" alt="User">
                            <% } %>
                            <span class="user-name"><%= video.username %></span>
                        </div>

                        <a href="<%= video.file_path %>" download class="btn btn-outline-secondary btn-sm w-100 mt-3">
                            <i class="fas fa-download me-1"></i> Download
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-5">
            <i class="fas fa-video-slash fa-3x text-muted mb-3"></i>
            <p class="text-muted">No edited videos found for this user.</p>
        </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>