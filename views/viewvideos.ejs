<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <title>Rally AI - My Videos</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: url('/images/k.jpg') no-repeat center center fixed;
      background-size: cover;
      color: white;
    }
    
    /* --- GALLERY STYLES --- */
    .video-gallery-container {
      max-width: 1000px;
      background-color: rgba(255, 255, 255, 0.95);
      color: black;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    }
    
    .media-card {
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #ddd;
        transition: transform 0.2s;
        background: #fff;
    }
    .media-card:hover { transform: translateY(-5px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
    
    .video-wrapper video { width: 100%; height: 200px; object-fit: cover; background: #000; }
    
    .media-meta { padding: 15px; }
    .media-prompt { font-size: 0.9rem; color: #555; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.7em; }
    .media-date { font-size: 0.75rem; color: #999; margin-top: 5px; display: block; }
    .download-link { font-size: 0.85rem; text-decoration: none; color: #0d6efd; font-weight: bold; }

    /* --- NEW BUTTON STYLES --- */
    .tiktok-btn {
        background-color: #010101; color: white !important; padding: 8px 20px; border-radius: 6px; 
        font-weight: bold; text-decoration: none; transition: 0.3s; display: inline-flex; align-items: center; border: 2px solid #010101;
        font-size: 0.9rem;
    }
    .tiktok-btn:hover { background-color: #fe2c55; border-color: #25f4ee; transform: translateY(-2px); box-shadow: 3px 3px 0px #25f4ee; }

    .editor-btn {
        background-color: #fd7e14; color: white !important; padding: 8px 20px; border-radius: 6px; 
        font-weight: bold; text-decoration: none; transition: 0.3s; display: inline-flex; align-items: center; border: 2px solid #fd7e14;
        font-size: 0.9rem;
    }
    .editor-btn:hover { background-color: #e36d0d; transform: translateY(-2px); }

  </style>
</head>
<body>

  <%- include ('partials/navbar.ejs') %>

  <div class="container d-flex flex-column align-items-center py-5">
    
    <div class="video-gallery-container w-100">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0 text-start"><i class="fas fa-film text-danger me-2"></i>My Generated Videos</h4>
            
            <div class="d-flex gap-2">
                <a href="/edit-library" class="editor-btn">
                    <i class="fas fa-edit me-2"></i>Editor
                </a>
                <a href="/tiktok" class="tiktok-btn">
                    <i class="fab fa-tiktok me-2"></i>TikTok
                </a>
            </div>
        </div>
        
        <% if (videos && videos.length > 0) { %>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <% videos.forEach(video => { %>
                    <div class="col">
                        <div class="media-card">
                            <div class="video-wrapper">
                                <video controls preload="metadata">
                                    <source src="<%= video.file_path %>" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>
                            </div>
                            <div class="media-meta text-start">
                                <p class="media-prompt" title="<%= video.prompt %>">"<%= video.prompt %>"</p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="media-date"><i class="far fa-calendar-alt me-1"></i><%= new Date(video.created_at).toLocaleDateString() %></span>
                                    
                                    <div class="d-flex align-items-center">
                                        <a href="<%= video.file_path %>" download class="download-link me-3">
                                            <i class="fas fa-download me-1"></i> Save
                                        </a>

                                        <a href="javascript:void(0)" 
                                           onclick="handleSaveToDrive('<%= video.file_path %>', '<%= video.video_id %>', 'video', this)" 
                                           class="text-success text-decoration-none fw-bold" 
                                           style="font-size: 0.85rem; cursor: pointer;">
                                            <i class="fab fa-google-drive me-1"></i> Drive
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="fas fa-video-slash fa-3x text-muted mb-3"></i>
                <p class="text-muted">You haven't generated any videos yet.</p>
                <a href="/?openBot=1" class="btn btn-primary">Start Creating Videos</a>
            </div>
        <% } %>
    </div>

  </div>

  <script>
    // ✅ GOOGLE DRIVE UPLOAD LOGIC
    async function handleSaveToDrive(fileUrl, uniqueId, type, btnElement) {
        
        // 1. Check if Google Tokens exist (Passed from Controller)
        const isGoogleLoggedIn = <%= (typeof tokens !== 'undefined' && tokens) ? 'true' : 'false' %>; 

        if (!isGoogleLoggedIn) {
            console.log("Not connected to Google. Redirecting to Auth...");
            const state = encodeURIComponent(JSON.stringify({ 
                action: 'save_to_drive', 
                fileUrl: fileUrl,
                returnTo: '/viewvideos' // Changed return path to this page
            }));
            window.location.href = `/auth/google?state=${state}`;
            return;
        }

        // 2. Determine Filename
        let fileName = `RallyAI_Video_${uniqueId}.mp4`;

        // 3. UI Feedback
        const originalContent = btnElement.innerHTML;
        btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';
        btnElement.style.pointerEvents = 'none';
        
        try {
            const response = await fetch('/drive/upload', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    fileUrl: fileUrl, 
                    fileName: fileName 
                })
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert("✅ Saved to Google Drive!");
                btnElement.innerHTML = '<i class="fas fa-check"></i> Saved';
            } else {
                throw new Error(result.error || "Unknown Error");
            }
        } catch (err) {
            console.error(err);
            alert("❌ Upload Failed: " + err.message);
            btnElement.innerHTML = originalContent; 
        } finally {
            btnElement.style.pointerEvents = 'auto'; 
        }
    }

    // Auto-save logic (triggered if returning from Google Auth)
    window.addEventListener('load', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('autosave') === 'true') {
            const fileUrl = urlParams.get('fileUrl');
            window.history.replaceState({}, document.title, window.location.pathname);
            alert("🔄 Completing your Save to Drive...");
            
            fetch('/drive/upload', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    fileUrl: fileUrl, 
                    fileName: `RallyAI_AutoSaved.mp4` 
                })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) alert("✅ Auto-save successful!");
                else alert("❌ Auto-save failed: " + data.error);
            })
            .catch(err => console.error(err));
        }
    });
  </script>

</body>
</html>